OPENAI_API_KEY=sk-your-openai-api-key
# Or use the alias if you prefer:
# ADVANCED_AI_API_KEY=sk-your-openai-api-key
AI_MODEL=gpt-5.4-mini
PORT=8000
JWT_SECRET=your-long-random-secret

# Optional Supabase replication support
SUPABASE_URL=https://your-supabase-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Market data analysis (uses Google Trends API via pytrends)
# No API key required - pytrends uses public Google Trends data
# Market analysis automatically runs when validating ventures
MARKET_ANALYSIS_ENABLED=true
